{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui:mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "ui:mock"
      ],
      "port": 1420
    },
    {
      "name": "ui:mock:vite",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ui && KKNOW_MOCK=1 ./node_modules/.bin/vite"
      ],
      "port": 1420
    },
    {
      "name": "ui:mock:1421",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ui && KKNOW_MOCK=1 ./node_modules/.bin/vite --port 1421 --strictPort"
      ],
      "port": 1421
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "docs:dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
