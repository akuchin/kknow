{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kknow",
  "version": "0.1.1",
  "identifier": "dev.kknow.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter kknow-ui dev",
    "beforeBuildCommand": "pnpm --filter kknow-ui build"
  },
  "app": {
    "windows": [
      {
        "title": "kknow",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
